# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-32-plus-char-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Cookie ─────────────────────────────────────────────────────────────────
# Set to your domain in production (e.g. ridss.team). Leave blank for localhost.
COOKIE_DOMAIN=

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ridss.db
